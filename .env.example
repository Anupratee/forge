# Copy to .env and adjust. .env is gitignored — never commit real secrets.
# Both docker-compose.yml and the server read this file.

# --- Server ---
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# --- Database (must match docker-compose.yml) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=forge
DB_USER=forge
DB_PASSWORD=forge_dev_password

# --- Auth ---
# Use a long random value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# --- Uploads (challenge covers, check-in proofs, receipts) ---
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880

# --- Optional: Redis cache (docker compose --profile cache up -d) ---
# Leave blank to run without caching.
REDIS_URL=
REDIS_PORT=6379

# --- Optional: AI bank-statement import ---
# Leave blank to disable the feature; manual and CSV entry remain available.
ANTHROPIC_API_KEY=
